{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "general": {
        ".read": "auth != null",
        "responders": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            "callsign": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 32" },
            "lat": { ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90" },
            "lng": { ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180" },
            "ce_m": { ".validate": "newData.val() == null || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000)" },
            "hae_m": { ".validate": "newData.val() == null || newData.isNumber()" },
            "le_m": { ".validate": "newData.val() == null || (newData.isNumber() && newData.val() >= 0)" },
            "heading_deg": { ".validate": "newData.val() == null || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 360)" },
            "speed_mps": { ".validate": "newData.val() == null || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 150)" },
            "device_time_ms": { ".validate": "newData.isNumber()" },
            "server_time_ms": { ".validate": "newData.isNumber()" },
            "last_seen_ms": { ".validate": "newData.val() == null || newData.isNumber()" },
            "online": { ".validate": "newData.isBoolean()" },
            "freshness_ttl_ms": { ".validate": "newData.isNumber() && newData.val() >= 15000 && newData.val() <= 300000" },
            "session_id": { ".validate": "newData.isString() && newData.val().length <= 80" },
            "$other": { ".validate": false }
          }
        },
        "tracks": {
          "$uid": {
            "$slot": {
              ".write": "auth != null && auth.uid === $uid",
              ".validate": "$slot.matches(/^[0-9]{1,3}$/)",
              "lat": { ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90" },
              "lng": { ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180" },
              "device_time_ms": { ".validate": "newData.isNumber()" },
              "server_time_ms": { ".validate": "newData.isNumber()" },
              "$other": { ".validate": false }
            }
          }
        }
      }
    }
  }
}
